{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist/client",
    "rootDir": "./src/client",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src/client/**/*"],
  "exclude": [
    "node_modules",
    "src/client/**/*.test.ts",
    "src/client/**/*.test.tsx",
    "src/client/game/testUtils.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
